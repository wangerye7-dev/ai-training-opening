{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-training-opening",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENING_ROOM",
        "class_name": "OpeningRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpeningRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

